{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.example/schemas/lesson.json",
  "title": "LearningOS Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lessonId",
    "revision",
    "title",
    "media",
    "blocks",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "lessonId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "video": {
          "$ref": "#/$defs/track"
        },
        "audio": {
          "$ref": "#/$defs/track"
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "transcripts": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "video": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      },
      "type": "object"
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "mimeType"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "video": {
              "type": "string"
            },
            "audio": {
              "type": "string"
            },
            "shared": {
              "type": "string"
            }
          }
        },
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "video": {
              "type": "number",
              "minimum": 0
            },
            "audio": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "answer",
        "blockId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "blockId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "segment": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      },
      "type": "object",
      "required": [
        "id",
        "start",
        "end",
        "text"
      ]
    }
  }
}
